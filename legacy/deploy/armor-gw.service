[Unit]
Description=armor-gw · LLM jailbreak gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=armor
Group=armor
WorkingDirectory=/opt/armor-gw
EnvironmentFile=/opt/armor-gw/.env
ExecStart=/opt/armor-gw/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8787 \
    --workers 4 --loop uvloop --http httptools \
    --timeout-keep-alive 75 --backlog 2048
Restart=always
RestartSec=2
LimitNOFILE=65535
StandardOutput=append:/var/log/armor-gw/access.log
StandardError=append:/var/log/armor-gw/error.log

# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/armor-gw/logs /opt/armor-gw/data /var/log/armor-gw
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
