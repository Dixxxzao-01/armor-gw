# ===== armor-gw 环境变量模板 =====
# 复制为 .env 后填写

# --- 服务 ---
GW_HOST=0.0.0.0
GW_PORT=8787
# 下游鉴权 key，逗号分隔（下游用 Bearer 传）
GW_KEYS=sk-armor-xxxx,sk-armor-yyyy
# 单 key 每分钟请求上限
GW_RPM=120
# 默认路由（上游 name）
GW_DEFAULT_ROUTE=primary
GW_LOG_DIR=./logs

# --- 上游：官方直连 ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-max

ZHIPU_API_KEY=
GLM_MODEL=glm-4-plus

MOONSHOT_API_KEY=
KIMI_MODEL=moonshot-v1-128k

# --- 上游：第三方聚合中转站（OpenAI 兼容即可）---
RELAY_BASE=
RELAY_API_KEY=
RELAY_MODEL=gpt-4o

# --- 上游：本地兜底（Ollama / vLLM / llama.cpp）---
LOCAL_BASE=http://127.0.0.1:11434/v1
LOCAL_API_KEY=no-key
LOCAL_MODEL=qwen2.5:14b

# --- 兜底单路由（上面全空时用这个）---
PRIMARY_BASE=https://api.openai.com/v1
PRIMARY_API_KEY=sk-placeholder
PRIMARY_MODEL=gpt-4o-mini
